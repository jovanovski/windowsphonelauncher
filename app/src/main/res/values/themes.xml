<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Windows XP Theme (Default / Base) -->
    <style name="Base.Theme.GokiXP" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Disable automatic tinting by setting neutral colors -->
        <item name="colorPrimary">@android:color/transparent</item>
        <item name="colorPrimaryVariant">@android:color/transparent</item>
        <item name="colorSecondary">@android:color/transparent</item>
        <item name="colorSecondaryVariant">@android:color/transparent</item>
        <item name="colorAccent">@android:color/transparent</item>
        <item name="colorControlNormal">@android:color/black</item>
        <item name="colorControlActivated">@android:color/black</item>
        <item name="colorControlHighlight">@android:color/transparent</item>
        <item name="colorButtonNormal">@android:color/transparent</item>
        <!-- Remove tinting from controls -->
        <item name="android:colorControlNormal">@android:color/black</item>
        <item name="android:colorControlActivated">@android:color/black</item>
        <item name="android:colorControlHighlight">@android:color/transparent</item>
        <!-- Windows XP specific attributes -->
        <item name="primaryFontFamily">@font/tahoma_font_family</item>
        <!-- Windows Phone 8.1 defaults, so wp81_* resources resolve under any theme. -->
        <item name="wpAccent">#1BA1E2</item>
        <item name="wpBackground">#000000</item>
        <item name="wpForeground">#FFFFFF</item>
        <item name="wpForegroundSubtle">#99FFFFFF</item>

    </style>

    <!--
      Windows Phone 8.1, and the only theme the shell has.

      A Theme.GokiXP.Vista used to sit between this and the base, because WP8.1 has no
      window chrome of its own and drew its programs in Vista's - so the two shared a
      layer. There is no other shell to share it with now, and what it contributed is set
      here directly: the Vista button style and the ground its windows stand on.

      The accent and Light/Dark values are the out-of-box defaults; the live ones come
      from WP81Settings and are applied programmatically, so they can change without
      recreating the activity.
    -->
    <style name="Theme.GokiXP.WP81" parent="Base.Theme.GokiXP">
        <item name="primaryFontFamily">@font/segoe_wp_family</item>
        <item name="wpAccent">#1BA1E2</item>
        <item name="wpBackground">#000000</item>
        <item name="wpForeground">#FFFFFF</item>
        <item name="wpForegroundSubtle">#99FFFFFF</item>
    </style>

    <!--
      The theme a web page's own text selection is drawn against.

      The grips either end of a selection come from the theme the WebView was built with,
      and every theme in here sets colorControlActivated to black so that the desktop
      chrome is not tinted - which leaves the browser dropping two black grips onto pages
      that are themselves black. They are given here instead, drawn to be seen against a
      page of any colour. Applied to the WebView alone, not to the window: nothing else in
      the shell should stop being black because the browser needs its grips visible.

      colorControlActivated is set as well as the three drawables. It is what tints the
      platform's own grips, and it is the one that has to be right if a WebView build ever
      reads it instead of them. IE's blue, from the phone.
    -->
    <style name="ThemeOverlay.GokiXP.WP81.PageSelection" parent="">
        <item name="android:textSelectHandleLeft">@drawable/wp81_text_select_handle_left</item>
        <item name="android:textSelectHandleRight">@drawable/wp81_text_select_handle_right</item>
        <item name="android:textSelectHandle">@drawable/wp81_text_select_handle_middle</item>
        <item name="colorControlActivated">#61ADDA</item>
        <item name="android:colorControlActivated">#61ADDA</item>
    </style>

</resources>