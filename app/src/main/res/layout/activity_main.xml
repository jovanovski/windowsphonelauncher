<?xml version="1.0" encoding="utf-8"?>

<!--
  The activity's whole content.

  Almost nothing, on purpose. This was the desktop launcher's window - a wallpaper, a
  taskbar, a start menu, a grid of desktop icons and a mouse cursor - and the phone shell
  hid every one of them on the way up. What is left is the frame the shell needs: a ground
  to sit on, a layer above it for windowed programs, and the context menu those programs
  raise. WP81Shell is added to main_background at runtime and draws the rest.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- The shell's ground. Painted the palette's background as the shell comes up. -->
    <RelativeLayout
        android:id="@+id/main_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="false"
        tools:context=".MainActivity">

        <!-- Windowed programs, above the shell but below its toast and switcher. -->
        <FrameLayout
            android:id="@+id/floating_windows_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginTop="60dp"
            android:layout_marginBottom="70dp"
            android:elevation="50dp" />

    </RelativeLayout>

    <!--
      The band the system's gesture bar sits in.

      The shell stops above it - see MainActivity.setupNavigationBarInsets, which lifts
      main_background clear of the inset - so what shows down there is the ground behind
      everything, and that ground is the page's colour. It has to be the navigation bar's
      instead: with the strip wearing the accent, a page-coloured band beneath it made two
      bars out of the one the phone has. Sized and painted at runtime.
    -->
    <View
        android:id="@+id/gesture_bar_strip"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_alignParentBottom="true" />

    <rocks.gorjan.gokixp.ContextMenuView
        android:id="@+id/context_menu"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:elevation="160dp" />

</RelativeLayout>
